{
  "cluster": "portfolio",
  "serviceName": "folio",
  "launchType": "EC2",
  "desiredCount": 1,
  "healthCheckGracePeriodSeconds": 60,
  "loadBalancers": [
    {
      "targetGroupArn": "__TARGET_GROUP_ARN__",
      "containerName": "folio",
      "containerPort": 8000
    }
  ],
  "deploymentConfiguration": {
    "deploymentCircuitBreaker": {
      "enable": true,
      "rollback": true
    },
    "minimumHealthyPercent": 0,
    "maximumPercent": 100
  },
  "placementConstraints": []
}
