# Copy to server/.env and fill in. Never commit the real .env.

# App
ENVIRONMENT=development
# CORS_ORIGINS is JSON when overriding, e.g. '["http://localhost:5173"]'
# Content-Security-Policy: enforce (default) | report-only | off
# CSP_MODE=enforce
# Per-IP rate limits (slowapi; in-memory, per instance)
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_GENERATE=30/minute

# MongoDB (docker-compose mongo)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=brand_content

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Where visitors reach the app. Production requires https (http only for localhost or
# 127.0.0.1); Turnstile tokens must have been issued for this host.
# APP_ORIGIN=http://localhost:5173

# Seeded demo user ("Explore as demo"). In production password sign-in is closed and the
# seed gives the demo user an unusable password, so DEMO_PASSWORD only works locally.
DEMO_EMAIL=demo@folio.studio
DEMO_PASSWORD=demo-folio-2026
DEMO_FULL_NAME=Demo User
# Check the demo seed when the API starts: build it on a fresh database and repair
# anything missing (files, vectors, the ready-made examples). It makes no paid call.
# `npm run seed` does the same on demand; stop the API first (one process per Chroma dir).
SEED_ON_STARTUP=true

# Cloudflare Turnstile, the bot check on each demo start. Leave both blank in development
# to use Cloudflare's always-pass test keys (answered locally, no network call).
# Production requires both, and refuses the test keys unless APP_ORIGIN is a loopback origin.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Per-IP demo starts (each start is a new 24-hour visitor session)
# DEMO_STARTS_PER_HOUR=15
# DEMO_STARTS_PER_DAY=50

# AI — generation (Anthropic)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# How much the model thinks before writing: low (default), medium, or high
# AI_EFFORT=low

# AI timeouts in seconds (the SDKs never retry, so a stalled call fails once)
# AI_REQUEST_TIMEOUT_S=60
# AI_STREAM_READ_TIMEOUT_S=30
# AI_STREAM_DEADLINE_S=90
# EMBEDDING_TIMEOUT_S=10

# AI — embeddings (OpenAI)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Vector store: chroma, in-process on local disk (no server). One process per directory.
VECTOR_STORE_BACKEND=chroma
CHROMA_PATH=./chroma

# Storage: local (the only implemented backend; s3 is planned for production)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=

# Proxies whose X-Forwarded-For is trusted (comma-separated IPs or CIDRs). Behind the
# load balancer in production, set this to the VPC CIDR; never "*" or a /0 network.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Images
UNSPLASH_ACCESS_KEY=

# AI dollar ledger (USD). AI_MONTHLY_BUDGET_USD=0 turns live AI off.
AI_MONTHLY_BUDGET_USD=10
AI_PACING_MULTIPLIER=3
AI_DAILY_FLOOR_USD=0.50
AI_VISITOR_BUDGET_USD=0.15
