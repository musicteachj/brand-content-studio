# Copy to server/.env and fill in. Never commit the real .env.

# App
ENVIRONMENT=development
# CORS_ORIGINS is JSON when overriding, e.g. '["http://localhost:5173"]'
# Content-Security-Policy: enforce (default) | report-only | off
# CSP_MODE=enforce
# Per-IP rate limits (slowapi; in-memory, per instance)
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_GENERATE=30/minute

# MongoDB (docker-compose mongo)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=brand_content

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeded demo user ("Explore as demo")
DEMO_EMAIL=demo@folio.studio
DEMO_PASSWORD=demo-folio-2026
DEMO_FULL_NAME=Demo User
# AI calls the demo account may make per UTC day
# DEMO_DAILY_GENERATION_LIMIT=50

# AI — generation (Anthropic)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# AI — embeddings (OpenAI)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Vector store: chroma (the only implemented backend; qdrant is planned for production)
VECTOR_STORE_BACKEND=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=brand-content-studio

# Storage: local (the only implemented backend; s3 is planned for production)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=

# Images
UNSPLASH_ACCESS_KEY=
